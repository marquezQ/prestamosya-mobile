{
  "expo": {
    "name": "PrestamosYA",
    "slug": "prestamosya-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "prestamosya",
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#206ba5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.prestamosyamobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "whatsapp-business",
          "tel"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.prestamosyamobile"
    },
    "web": {
      "favicon": "./assets/LogoP.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que PrestamosYA acceda a tu ubicación para fijar la dirección de cobro."
        }
      ],
      [
        "expo-image-picker",
        {
          "photoPermission": "Permitir que PrestamosYA acceda a tus fotos para adjuntar imágenes de las garantías."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
